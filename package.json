{
  "name": "tak",
  "version": "1.1.10",
  "private": true,
  "description": "Google Sheets project tracker with interactive sheet, Kanban and Gantt views",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "stop": "node scripts/stop.mjs",
    "test": "node --test",
    "test:browser": "playwright test",
    "check": "npm run build && npm test",
    "clasp:info": "node scripts/clasp-info.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
